# Copy to backend/.env and fill in. Never commit the real .env.

# Only PAPER exists. Live modes are refused at startup.
MODE=PAPER

# SQLite for a laptop; Postgres via docker compose (see infra/docker-compose.yml).
DATABASE_URL=sqlite:///./algotrade.db
# DATABASE_URL=postgresql+psycopg://algotrade:change-me@localhost:5432/algotrade

# upstox (real-time, needs login each day) | yfinance (delayed, research only) | replay (offline demo)
DATA_PROVIDER=upstox

# Upstox developer app: https://account.upstox.com/developer/apps
# The redirect URL registered in the app must equal UPSTOX_REDIRECT_URI exactly.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/upstox/callback

# Groq: https://console.groq.com/keys  (model list: https://console.groq.com/docs/models)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Telegram alerts (warnings and critical only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set a long random string to require it on every API call (recommended on a VPS).
API_TOKEN=
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
